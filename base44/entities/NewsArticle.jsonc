{
  "name": "NewsArticle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "article_url": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "published",
        "rejected"
      ],
      "default": "pending"
    },
    "published_at": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "status"
  ]
}